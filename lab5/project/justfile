set quiet

root := justfile_directory()

# Public: task1 (single run, plots), task2 (parallel runs + aggregate).

default:
    @echo "lab5:  just task1        — task 1 quick single run"
    @echo "       just task1-plots  — task 1 benchmark CSV + matplotlib figures"
    @echo "       just task2         — task 2 parallel runs (optional: N, -v)"
    @echo "       just task3         — task 3 live status thread (optional: interval ms)"
    @just --list

[private]
build:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    rm -rf out
    mkdir -p out
    javac -encoding UTF-8 -d out $(find src -name '*.java')

task1:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    just build
    java -cp out lab5.task1.Task1Main

task1-plots:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    just build
    mkdir -p results
    java -Dlab5.home="{{ root }}" -cp out lab5.task1.Task1Benchmark
    cd "{{ root }}/plots" && uv sync && uv run python -m lab5_plots \
      --by-load "../results/lab5_by_load.csv" \
      --by-queue "../results/lab5_by_queue.csv" \
      --out "../results/figures_task1"

# Task 2: parallel independent simulations; default 8 runs, min 4. Examples: just task2, just task2 12, just task2 8 -v
task2 *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    just build
    java -cp out lab5.task2.Task2Main {{ ARGS }}

# Task 3: periodic status in separate thread; optional reporter interval in ms (default 100, min 50)
task3 *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    just build
    java -cp out lab5.task3.Task3Main {{ ARGS }}

print-java:
    #!/usr/bin/env bash
    set -euo pipefail
    bash "{{ root }}/scripts/dump_lab5_java.sh"
